diff --git a/kernel/sysproc.c b/kernel/sysproc.c
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -110,3 +110,13 @@
   release(&tickslock);
   return xticks;
 }
+
+// Enable tracing for this process; kfork() copies the mask to its child.
+uint64
+sys_trace(void)
+{
+  int mask;
+  argint(0, &mask);
+  myproc()->trace_mask = mask;
+  return 0;
+}
